# ==========================================
# Investor Intelligence Platform - Env Config
# ==========================================

# Application Environment
APP_ENV=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# OpenRouter API (Free Tier)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Postgres Connection (with pgvector)
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase Storage & Project Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key